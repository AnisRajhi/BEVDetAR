-def average_losses(
-    accumulator,
-    count,
-):
-    """
-    Moyenne des losses sur un epoch complet.
-    """
-
-    if count == 0:
-
-        raise RuntimeError(
-            "Cannot average zero batches."
-        )
-
-    return {
-
-        key: value / count
-
-        for key, value
-        in accumulator.items()
-    }
