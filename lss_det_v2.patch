+            + f"  {e['mAP']:.3f}  {e.get('ATE', 1):.3f}  {e.get('ASE', 1):.3f}  {e.get('AOE', 1):.3f}  {e.get('max_recall', 0):.3f}"
+        )
+    bands = "  ".join(f"{k}: {v[0]:.2f} (n={v[1]})" for k, v in res["recall_by_distance@2m"].items())
+    lines.append(f"rappel @2m par distance : {bands}")
+    return "\n".join(lines)
