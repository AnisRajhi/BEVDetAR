+    s1["anns"] = []
+    s1["data"]["CAM_FRONT"] = "sd_missing"
+    fake.tables["sample_data"]["sd_missing"] = dict(fake.tables["sample_data"]["sd_CAM_FRONT"])
+    fake.paths["sd_missing"] = "/n/existe/pas/CAM_FRONT.jpg"
+    fake.sample.append(s1)
+
