+
+
+def format_report(res: Dict) -> str:
+    lines = [f"mAP = {res['mAP']:.4f} | ATE = {res['ATE']:.3f} m | ASE = {res['ASE']:.3f} | AOE = {res['AOE']:.3f} rad"]
